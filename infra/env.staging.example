# Maple Garden Events — Staging environment (App Runner / Secrets Manager)
# Copy values into AWS Secrets Manager secret: maple-events/staging

NODE_ENV=production
PORT=5000
SERVE_CLIENT=true

# Required
DATABASE_URL=postgresql://USER:PASSWORD@STAGING-RDS-HOST:5432/maple_staging?sslmode=require
JWT_SECRET=generate-a-32-char-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_URL=https://staging.your-domain.com

# Go-Live decisions (see docs/GO-LIVE-DECISIONS.md)
EASYCOUNT_MODE=simulation
EASYCOUNT_MOCK_MODE=true

# AWS S3 — file storage
S3_BUCKET=maple-events-staging-files
AWS_REGION=il-central-1

# Optional integrations (staging can use test credentials)
# Meta WhatsApp Cloud API (preferred)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MANAGER_ALERT_PHONE=
WHATSAPP_CONTRACT_TEMPLATE=
WHATSAPP_EVENT_FORM_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=he

# Green API fallback
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
EMAIL_USER=
EMAIL_PASS=
MANAGER_EMAIL=
MANAGER_ALERT_EMAIL=
MANAGER_ALERT_PHONE=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TENANT_NAME=maple-garden-staging

# Ops alerting + APM
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=300000
SLOW_QUERY_MS=500
SLOW_REQUEST_MS=2000
HEALTH_CHECK_TIMEOUT_MS=2500

# Backups
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
S3_BACKUP_BUCKET=maple-events-staging-backups
S3_BACKUP_PREFIX=database-backups

# Puppeteer (Docker image sets this automatically)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
