# Maple Garden Events — Production environment (App Runner / Secrets Manager)
# Copy values into AWS Secrets Manager secret: maple-events/production

NODE_ENV=production
PORT=5000
SERVE_CLIENT=true

# Required
DATABASE_URL=postgresql://USER:PASSWORD@PROD-RDS-HOST:5432/maple_production?sslmode=require
JWT_SECRET=generate-a-strong-64-char-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CLIENT_URL=https://app.your-domain.com

# EasyCount — start with mock=true until UAT sign-off (see GO-LIVE-DECISIONS.md)
EASY_COUNT_MOCK_MODE=true
EASY_COUNT_API_URL=
EASY_COUNT_API_KEY=
EASY_COUNT_MERCHANT_ID=
EASY_COUNT_WEBHOOK_SECRET=

# AWS S3 — file storage (SSE enabled on bucket)
S3_BUCKET=maple-events-prod-files
AWS_REGION=il-central-1

# WhatsApp / Email
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
EMAIL_USER=
EMAIL_PASS=
MANAGER_EMAIL=
MANAGER_ALERT_EMAIL=
MANAGER_ALERT_PHONE=

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TENANT_NAME=maple-garden

# Backups
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
S3_BACKUP_BUCKET=maple-events-prod-backups
S3_BACKUP_PREFIX=database-backups
BACKUP_RETENTION_DAYS=30

# Puppeteer (Docker image sets this automatically)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
