# =============================================================================
# Maple Garden Events — Server Environment (copy to .env and fill in values)
# =============================================================================

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Schema changes: edit prisma/schema.prisma then run locally:
#   npm run db:migrate          # prisma migrate dev (creates + applies)
# Deploy / App Runner uses:
#   npm run db:migrate:deploy   # prisma migrate deploy (see docs/DATABASE-MIGRATIONS.md)
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Google Cloud Vision (check OCR via ADC — no API keys in code) ---
# Local: path to a service-account JSON with Cloud Vision API enabled.
# Production (App Runner / GCE / etc.): omit this and use the attached IAM role.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\vision-service-account.json
# Quota / billing project for Vision (defaults to mepal-project in code if unset)
GOOGLE_CLOUD_PROJECT=mepal-project

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVE_CLIENT=false
# Set to true only when the site runs behind HTTPS. Set to false for HTTP (staging/dev).
COOKIE_SECURE=false

# --- Redis (optional — response caching only) ---
# Leave unset for local Windows/dev without Redis. Example: redis://127.0.0.1:6379
# REDIS_URL=

# --- AWS S3 — private file storage (contracts, checks, signatures) ---
# Bucket must have SSE-S3 (AES256) enabled; App Runner can use IAM role instead of keys
S3_BUCKET=
AWS_REGION=il-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PRESIGN_TTL_SECONDS=3600

# --- Go-Live seeding (npm run seed:authorized-users) ---
AUTHORIZED_USERS_EMAILS=

# --- EasyCount (unified — advance receipts + hall invoices + webhooks) ---
# Mode: off | simulation | sandbox | live  (default: simulation)
EASYCOUNT_MODE=simulation
# Document API (advance receipts / createDoc) — required for sandbox/live receipts
EASYCOUNT_API_KEY=
EASYCOUNT_DEVELOPER_EMAIL=
# Optional: email client a copy when mode=live
EASYCOUNT_SEND_EMAIL=false
# Hall-invoice REST API (optional — use MOCK_MODE for local without credentials)
EASYCOUNT_MOCK_MODE=false
EASYCOUNT_API_URL=
EASYCOUNT_MERCHANT_ID=
# Webhook HMAC secret for POST /api/webhooks/easy-count
EASYCOUNT_WEBHOOK_SECRET=
# Optional HTTP timeout for EasyCount calls (ms, default 20000)
# EASYCOUNT_API_TIMEOUT_MS=20000
#
# Legacy aliases still accepted: EASY_COUNT_MOCK_MODE, EASY_COUNT_API_URL,
# EASY_COUNT_API_KEY, EASY_COUNT_MERCHANT_ID, EASY_COUNT_WEBHOOK_SECRET

# --- Email (optional — without these, emails are simulated/logged) ---
EMAIL_USER=
EMAIL_PASS=
MANAGER_EMAIL=
MANAGER_ALERT_EMAIL=
MANAGER_ALERT_PHONE=

# --- WhatsApp Meta Cloud API (preferred when set) ---
# Webhook callback URL: https://YOUR_DOMAIN/api/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Hall manager phone for inbound forwards + deal-close copies
MANAGER_ALERT_PHONE=
# Optional approved Meta template names (sent before PDF document)
WHATSAPP_CONTRACT_TEMPLATE=
WHATSAPP_EVENT_FORM_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=he
# Optional Graph API version (default v20.0)
# WHATSAPP_GRAPH_VERSION=v20.0

# --- WhatsApp Green API (optional fallback if Cloud API unset) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# --- Twilio SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TENANT_NAME=maple-garden

# --- Ops alerting (optional — Slack/Discord/Teams webhook + email) ---
# POST JSON payload on critical errors / crashes / cron failures
ALERT_WEBHOOK_URL=
# Dedupe window for identical alerts (ms). Default 300000 (5 minutes).
ALERT_COOLDOWN_MS=300000

# --- APM thresholds (optional) ---
# Warn + count when Prisma ops exceed this (ms). Default 500.
SLOW_QUERY_MS=500
# Warn + count when HTTP requests exceed this (ms). Default 2000.
SLOW_REQUEST_MS=2000
# Per-dependency timeout for deep /api/health checks (ms). Default 2500.
HEALTH_CHECK_TIMEOUT_MS=2500
# Set true to emit Prisma engine query events (verbose).
PRISMA_LOG_QUERIES=false

# --- Database backups (optional) ---
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=database-backups
BACKUP_RETENTION_DAYS=30

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=info

# --- Puppeteer (Docker sets PUPPETEER_EXECUTABLE_PATH automatically) ---
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=

# =====================================================================
# WhatsApp Business Platform integration (docs/whatsapp/configuration.md)
#
# NEVER commit real values. Use environment variables / your deployment's
# secret store. The block above (WHATSAPP_TOKEN, WHATSAPP_VERIFY_TOKEN,
# WHATSAPP_APP_SECRET) still works and is read as a fallback.
# =====================================================================

# Master switch. Leave false locally — nothing is sent while this is false.
WHATSAPP_ENABLED=false

# meta | fake | disabled. Use "fake" for local development and tests.
WHATSAPP_PROVIDER=fake

# --- Meta credentials (required only when WHATSAPP_ENABLED=true and provider=meta) ---
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=

# --- Graph API ---
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
# Latest at time of writing is v26.0; v25.0 is supported until 2028-07-29.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TIMEOUT_MS=15000

# --- Retry / resilience ---
WHATSAPP_RETRY_MAX_ATTEMPTS=5
WHATSAPP_RETRY_INITIAL_DELAY_MS=30000
WHATSAPP_RETRY_MAX_DELAY_MS=3600000
# A Processing row whose worker died is released after this long.
WHATSAPP_CLAIM_TIMEOUT_MS=300000

# --- Features ---
# true = webhook returns 200 immediately and the worker does the processing.
WHATSAPP_ASYNC_WEBHOOK=false
WHATSAPP_FORWARD_INBOUND_TO_MANAGER=true
# Automation rules only run when this is true AND the rule row is enabled.
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_STORE_RAW_PAYLOADS=true

# --- Behaviour ---
WHATSAPP_DEFAULT_LANGUAGE=he
WHATSAPP_DEFAULT_COUNTRY_CODE=972
WHATSAPP_OUTBOX_BATCH_SIZE=20
WHATSAPP_WEBHOOK_RETENTION_DAYS=90
WHATSAPP_WEBHOOK_MAX_RETRIES=5

# Required only when several active tenants share one WhatsApp number.
WHATSAPP_TENANT_ID=

# --- Worker schedules (node-cron) ---
WHATSAPP_OUTBOX_CRON=* * * * *
WHATSAPP_WEBHOOK_CRON=* * * * *
WHATSAPP_AUTOMATION_CRON=30 8 * * *
WHATSAPP_CLEANUP_CRON=30 3 * * *

# --- Post-event feedback (see docs/FEEDBACK-FLOW.md) ---
# Timezone for ALL calendar decisions. Must be the venue's civil timezone.
TZ=Asia/Jerusalem
# Sweep schedule. Idempotent — running it more often is safe.
FEEDBACK_CRON=0 * * * *
# Local hour at which the previous day's surveys go out.
FEEDBACK_SEND_HOUR=10
# Events ending before this local hour belong to the previous civil day
# (weddings that run past midnight).
FEEDBACK_NIGHT_ROLLOVER_HOUR=5
# How far back the sweep looks. Bounds catch-up after downtime and stops a fresh
# deployment from mass-mailing historical events.
FEEDBACK_LOOKBACK_DAYS=14
# Delivery attempts per recipient before the row is parked for manual re-send.
FEEDBACK_MAX_NOTIFY_ATTEMPTS=5
# Minimum wait between two delivery attempts for the same recipient.
FEEDBACK_RETRY_BACKOFF_MINUTES=60
# Nightly archive job — independent of the feedback flow.
ARCHIVE_CRON=0 0 * * *
