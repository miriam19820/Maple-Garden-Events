# =============================================================================
# Maple Garden Events — Server Environment (copy to .env and fill in values)
# =============================================================================

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Google Cloud Vision (check OCR via ADC — no API keys in code) ---
# Local: path to a service-account JSON with Cloud Vision API enabled.
# Production (App Runner / GCE / etc.): omit this and use the attached IAM role.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\vision-service-account.json
# Quota / billing project for Vision (defaults to mepal-project in code if unset)
GOOGLE_CLOUD_PROJECT=mepal-project

# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVE_CLIENT=false

# --- AWS S3 — private file storage (contracts, checks, signatures) ---
# Bucket must have SSE-S3 (AES256) enabled; App Runner can use IAM role instead of keys
S3_BUCKET=
AWS_REGION=il-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PRESIGN_TTL_SECONDS=3600

# --- Go-Live seeding (npm run seed:authorized-users) ---
AUTHORIZED_USERS_EMAILS=

# --- Easy Count (invoicing / payment — optional) ---
# Set MOCK_MODE=true for local dev without real API credentials
EASY_COUNT_MOCK_MODE=false
EASY_COUNT_API_URL=
EASY_COUNT_API_KEY=
EASY_COUNT_MERCHANT_ID=
EASY_COUNT_WEBHOOK_SECRET=

# --- Email (optional — without these, emails are simulated/logged) ---
EMAIL_USER=
EMAIL_PASS=
MANAGER_EMAIL=
MANAGER_ALERT_EMAIL=
MANAGER_ALERT_PHONE=

# --- WhatsApp Green API (optional) ---
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# --- Twilio SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TENANT_NAME=maple-garden

# --- Database backups (optional) ---
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=database-backups
BACKUP_RETENTION_DAYS=30

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=info

# --- Puppeteer (Docker sets PUPPETEER_EXECUTABLE_PATH automatically) ---
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=
