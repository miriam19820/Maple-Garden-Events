{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "predev": "npm run build --prefix ../shared",
    "dev": "tsx watch src/server.ts",
    "dev:watch": "npm run predev && node --watch --watch-path=src/app.ts --watch-path=src/server.ts --watch-path=src/controllers --watch-path=src/Services --watch-path=src/routes --watch-path=src/utils --watch-path=src/middlewares --watch-path=src/config --watch-path=src/validators --watch-path=src/models -r ts-node/register src/server.ts",
    "prebuild": "npm run build --prefix ../shared",
    "build": "tsc",
    "postinstall": "prisma generate",
    "tunnel": "powershell -ExecutionPolicy Bypass -File scripts/start-public-tunnel.ps1",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "bash scripts/db-migrate-deploy.sh",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "data:backfill-event-codes": "ts-node scripts/migrate-legacy-event-codes.ts",
    "fix:contract-sync": "ts-node scripts/fix-contract-sync.ts",
    "sync:contract-text": "npm run prebuild && ts-node scripts/sync-contract-text.ts",
    "verify:double-booking": "ts-node scripts/verify-no-double-booking.ts",
    "sentry:verify": "ts-node scripts/sentry-verify.ts",
    "seed:authorized-users": "ts-node scripts/seed-authorized-users.ts",
    "db:import-legacy": "ts-node scripts/import-legacy-bookings.ts",
    "pretest": "npm run build --prefix ../shared",
    "test": "jest",
    "test:unit": "node --require ts-node/register/transpile-only --test tests/contract-lineItems.test.ts",
    "pretest:security": "npm run build --prefix ../shared",
    "test:security": "jest tests/security.test.ts",
    "pretest:integration": "npm run build --prefix ../shared",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@google-cloud/vision": "^5.3.7",
    "@maple/shared": "*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.59.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-static-gzip": "^3.0.1",
    "google-auth-library": "^10.7.0",
    "hebcal": "^2.3.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "prisma": "^6.19.3",
    "puppeteer": "^25.1.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  }
}
