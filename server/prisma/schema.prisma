generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  subdomain           String               @unique
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  bookings            Booking[]
  hallInvoices        HallInvoice[]
  bookingPayments     BookingPayment[]
  eventCheckIns       EventCheckIn[]
  menuCategories      MenuCategory[]
  dishes              Dish[]
  eventDates          EventDate[]
  eventForms          EventForm[]
  cancellationLogs    CancellationLog[]
  tablePositions      TablePosition[]
  systemSettings      SystemSettings[]
  extraServices       ExtraService[]
  staffMembers        StaffMember[]
  feedbacks           Feedback[]
  kashrutCertificates KashrutCertificate[]
  eventAdditions      EventAddition[]
  authorizedUsers          AuthorizedUser[]
  scheduledGreetings       ScheduledGreeting[]
  whatsappInboundMessages  WhatsAppInboundMessage[]
  whatsappConversations    WhatsAppConversation[]
  whatsappMessages         WhatsAppMessage[]
  whatsappOutboxMessages   WhatsAppOutboxMessage[]
  whatsappWebhookEvents    WhatsAppWebhookEvent[]
  whatsappTemplates        WhatsAppTemplate[]
  whatsappAutomationRules  WhatsAppAutomationRule[]
  designGalleryItems       DesignGalleryItem[]
}

model Booking {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  clientAFullName     String
  clientAIdNumber     String
  clientAPhone        String
  clientAEmail        String?
  clientAAddress      String?
  clientBFullName     String?
  clientBIdNumber     String?
  clientBPhone        String?
  clientBEmail        String?
  clientBAddress      String?
  calendarDateId      String
  eventType           String
  timeOfDay           String
  timeSlot            String          @default("evening")
  guestCount          Int
  minimumGuestCount   Int?
  finalPricePortion   Float
  managerComments     String?
  clientComments      String?
  totalPrice          Float
  basePrice           Float           @default(0)
  extrasPrice         Float           @default(0)
  externalExtrasPrice Float           @default(0)
  liveAdditionsTotal  Float           @default(0)
  hallRentalPrice     Float?          
  paidAmount          Float           @default(0)
  paymentStatus       String          @default("pending")
  eventCode           String          @unique
  hasMusic            Boolean         @default(true)
  akumApprovalCode    String?
  advancePaid         Float           @default(0)
  totalPaid           Float           @default(0)
  securityCheckStatus String          @default("PENDING")
  securityCheckUrl    String?
  isContractSigned    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  createdBy           String
  updatedAt           DateTime        @updatedAt
  updatedBy           String?
  cancellationReason  String?
  isOption            Boolean         @default(false)
  leadSource          String?
  optionDurationHours Int             @default(48)
  eventDate           EventDate       @relation(fields: [calendarDateId], references: [id])
  additions           EventAddition[]
  eventForm           EventForm?
  eventCheckIn        EventCheckIn?
  feedbacks           Feedback[]
  clientSignatureUrl  String?
  clientBSignatureUrl String?
  depositCheckUrl     String?
  depositCheckDetails Json?
  depositMethod       String?
  easycountDocId      String?
  easycountDocUrl     String?
  easycountStatus     String?
  easycountError      String?
  vatType             String          @default("included")
  contractText        String?         @db.Text
  paymentTemplateId   String?
  paymentTermsText    String?         @db.Text
  paymentDeadline     DateTime?
  depositPaid         Boolean         @default(false)
  lastPaymentReminderSent DateTime?
  upgrades            Json?
  kosherType          String?
  hallInvoices             HallInvoice[]
  payments                 BookingPayment[]
  whatsappInboundMessages  WhatsAppInboundMessage[]
  whatsappConversations    WhatsAppConversation[]
  whatsappMessages         WhatsAppMessage[]
  whatsappOutboxMessages   WhatsAppOutboxMessage[]
  /** Set after the post-event financial summary WhatsApp is sent to the manager. */
  financialSummarySentAt   DateTime?

  @@unique([calendarDateId, timeSlot])
  @@index([tenantId])
}

model HallInvoice {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  externalId       String    @unique
  amount           Float
  status           String    @default("pending")
  paymentUrl       String?
  installmentLabel String?
  description      String?
  paidAt           DateTime?
  webhookPayload   Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         BookingPayment[]

  @@index([bookingId])
  @@index([status])
  @@index([tenantId])
}

/**
 * Immutable-style payment ledger for an event/booking.
 * Aggregates (advancePaid / totalPaid) are recomputed from this table.
 */
model BookingPayment {
  id                     String       @id @default(uuid())
  tenantId               String
  tenant                 Tenant       @relation(fields: [tenantId], references: [id])
  bookingId              String
  booking                Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount                 Float
  paidAt                 DateTime     @default(now())
  /** cash | credit_card | check | bank_transfer | easycount | other */
  paymentMethod          String
  /** EasyCount receipt / transaction / invoice external id — unique when present */
  easycountTransactionId String?      @unique
  hallInvoiceId          String?
  hallInvoice            HallInvoice? @relation(fields: [hallInvoiceId], references: [id], onDelete: SetNull)
  /** ADVANCE | EASYCOUNT_INVOICE | MANUAL */
  source                 String       @default("MANUAL")
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([bookingId])
  @@index([tenantId])
  @@index([paidAt])
}

model EventCheckIn {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  bookingId             String   @unique
  familiesLabel         String?
  orderedPortions       Int?
  entertainerPortions   Int?
  reservePortions       Int?
  hallReceivedConfirmed Boolean  @default(false)
  reserveTables         Json?
  specialAdditions      String?
  customerSignature     String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model MenuCategory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  dishes   Dish[]

  @@index([tenantId])
}

model Dish {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  price       Float?
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
}

model EventDate {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  date            DateTime  @unique
  status          String
  lockedBy        String?
  clientName      String?
  clientPhone     String?
  clientEmail     String?
  optionExpiresAt DateTime?
  bookings        Booking[]

  @@index([tenantId])
}

model EventForm {
  id                  String          @id @default(uuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  bookingId           String          @unique
  eventTime           String?
  receptionType       String?
  finalGuestCount     Int?
  seatingType         String?
  menPercent          Int?
  womenPercent        Int?
  honorTableCount     Int?
  tableclothId        String?
  napkinId            String?
  centerpiece         String?
  bridgeChair         String?
  hasLighting         Boolean         @default(false)
  hasSoundSystem      Boolean         @default(false)
  hasScreens          Boolean         @default(false)
  hasFireworks        Boolean         @default(false)
  entertainersBar     Int?
  entertainersSitting Int?
  entertainersMen     Int?
  entertainersWomen   Int?
  depositCheckUrl     String?
  depositCheckStatus  Boolean         @default(false)
  depositCheckDetails Json?
  akumCode            String?
  kashrut             String?
  guestPortionCount   Int?
  pricePerPortion     Float?
  kashrutSurcharge    Float?
  designPrice         Float?
  extrasJson          String?
  totalPrice          Float?
  contractSigned      Boolean         @default(false)
  contractSentAt      DateTime?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  booking             Booking         @relation(fields: [bookingId], references: [id])
  tables              TablePosition[]
  menuSelections      Json?
  akumPaid            Boolean?
  tableLayoutImageUrl String?

  @@index([tenantId])
}

model CancellationLog {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  reason     String
  clientName String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model TablePosition {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  eventFormId String
  tableNumber Int
  positionX   Float
  positionY   Float
  section     String?
  isHonor     Boolean   @default(false)
  width       Float?
  height      Float?
  eventForm   EventForm @relation(fields: [eventFormId], references: [id], onDelete: Cascade)

  @@unique([eventFormId, tableNumber])
  @@index([tenantId])
}

model SystemSettings {
  id                     String   @id @default("global")
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id])
  vatRate                Float    @default(17.0)
  defaultAdvance         Float    @default(5000.0)
  optionDurationHours    Int      @default(48)
  basePricePerPortion    Float    @default(250.0)
  kashrutSurcharge       Float    @default(30.0)
  staffPortionPrice      Float    @default(120.0)
  designBasePrice        Float    @default(4500.0)
  centerpiecePrice       Float    @default(150.0)
  bridgeChairPrice       Float    @default(800.0)
  lightingPrice          Float    @default(2500.0)
  soundSystemPrice       Float    @default(2000.0)
  screensPrice           Float    @default(1500.0)
  fireworksPrice         Float    @default(1000.0)
  akumFee                Float    @default(350.0)
  updatedAt              DateTime @updatedAt
  extraSecurityPrice     Float    @default(650.0)
  nextEventNumber        Int      @default(0)
  receptionPrice         Float    @default(2000.0)
  separateReceptionPrice Float    @default(3000.0)
  contractText           String?  @db.Text
  barPortionPrice        Float    @default(60.0)
  paymentTemplates       Json?
  defaultPaymentTemplateId String?
  hiddenPriceFields      Json     @default("[]")

  @@index([tenantId])
}

model ExtraService {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  category  String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

/** Catalog of design options (tablecloths, napkins, etc.) with images for the event form gallery. */
model DesignGalleryItem {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  category     String
  name         String
  description  String?
  modelCode    String?
  imageUrl     String
  /** Lightweight WebP (or equivalent) for grid display; falls back to imageUrl when null. */
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, category])
}

model StaffMember {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

/**
 * Feedback token + result (hybrid FeedbackToken / FeedbackResult).
 * - token / isCompleted / completedAt → one-time response link per side
 * - foodRating / serviceRating / venueRating / comments → quantitative result
 * bookingId is the event reference (no separate Event table).
 */
model Feedback {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  bookingId         String
  /** Side A / Side B ('A' | 'B') for dual-sided events */
  clientSide        String
  clientName        String?
  foodRating        Int?
  serviceRating     Int?
  /** Venue / hall quality (maps to "Cleanliness" category in product language). */
  venueRating       Int?
  averageScore      Float?
  comments          String?
  token             String    @unique
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  lastNotifiedAt    DateTime?
  lastEmailSent     Boolean   @default(false)
  lastWhatsappSent  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id])

  @@unique([bookingId, clientSide])
  @@index([tenantId])
}

model KashrutCertificate {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  nameKey             String
  displayName         String
  imageUrl            String?
  validUntil          DateTime?
  updatedAt           DateTime  @updatedAt
  isGlobalCertificate Boolean   @default(false)

  @@index([tenantId])
}

model EventAddition {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  bookingId     String
  description   String
  cost          Float
  staffName     String
  signature     String
  agreedToTerms Boolean
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@index([tenantId])
}

model AuthorizedUser {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  role      String   @default("manager")
  createdAt DateTime @default(now())

  whatsappConversations WhatsAppConversation[] @relation("WhatsAppConversationAssignee")

  @@index([tenantId])
}

model ScheduledGreeting {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  subject        String
  message        String    @db.Text
  scheduledAt    DateTime
  attachmentPath String?
  attachmentName String?
  status         String    @default("PENDING")
  sentAt         DateTime?
  sendStats      Json?
  errorMessage   String?
  createdBy      String?
  createdAt      DateTime  @default(now())

  @@index([tenantId])
}

/** Inbound Meta WhatsApp Cloud messages linked (when possible) to a booking. */
model WhatsAppInboundMessage {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  bookingId            String?
  booking              Booking? @relation(fields: [bookingId], references: [id])
  fromPhone            String
  waMessageId          String   @unique
  messageType          String
  text                 String?  @db.Text
  forwardedToManager   Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([tenantId])
  @@index([fromPhone])
  @@index([bookingId])
}

// =====================================================================
// WhatsApp Business Platform integration
// Statuses/enums are stored as String to match this schema's convention;
// the allowed values live in server/src/Services/whatsapp/types.ts.
// =====================================================================

/// One thread per (tenant, phone). Enables a future manager inbox.
model WhatsAppConversation {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  bookingId      String?
  booking        Booking?  @relation(fields: [bookingId], references: [id])
  /// E.164 digits, no leading '+' (Meta Cloud `to` format).
  phoneNumber    String
  /// Unassigned | Assigned | WaitingForCustomer | WaitingForManager | Closed
  status         String    @default("Unassigned")
  assignedUserId String?
  assignedUser   AuthorizedUser? @relation("WhatsAppConversationAssignee", fields: [assignedUserId], references: [id])
  lastMessageAt  DateTime?
  /// Last inbound message time — drives Meta's 24h customer-care window.
  lastInboundAt  DateTime?
  unreadCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages       WhatsAppMessage[]
  outboxMessages WhatsAppOutboxMessage[]

  @@unique([tenantId, phoneNumber])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([bookingId])
  @@index([assignedUserId])
}

/// Unified ledger of every inbound and outbound WhatsApp message.
model WhatsAppMessage {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  conversationId    String
  conversation      WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?  @relation(fields: [bookingId], references: [id])
  /// Inbound | Outbound
  direction         String
  /// text | template | document | image | audio | video | interactive | location | unknown
  messageType       String
  content           String?   @db.Text
  templateName      String?
  /// Provider payload kept for auditing/troubleshooting (see retention config).
  payload           Json?
  /// Meta `wamid.*`. Unique per tenant — the only key used for status matching.
  externalMessageId String?
  /// Pending | Processing | Sent | Delivered | Read | Failed | Cancelled | Received
  status            String    @default("Pending")
  errorCode         String?
  errorMessage      String?   @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  outboxMessage     WhatsAppOutboxMessage?

  @@unique([tenantId, externalMessageId])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, status])
  @@index([externalMessageId])
  @@index([bookingId])
}

/// Transactional outbox — business code enqueues here, the worker sends.
model WhatsAppOutboxMessage {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  conversationId    String?
  conversation      WhatsAppConversation? @relation(fields: [conversationId], references: [id])
  messageId         String?   @unique
  message           WhatsAppMessage? @relation(fields: [messageId], references: [id])
  bookingId         String?
  booking           Booking?  @relation(fields: [bookingId], references: [id])
  toPhone           String
  /// text | template | document | media | interactive
  messageType       String
  templateName      String?
  templateLanguage  String?
  /// Provider-agnostic request body (see SendRequest in types.ts).
  payload           Json
  /// Pending | Processing | Sent | Failed | Cancelled
  status            String    @default("Pending")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  nextAttemptAt     DateTime  @default(now())
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  externalMessageId String?
  lastError         String?   @db.Text
  lastErrorCode     String?
  /// Worker instance holding the claim; cleared on release.
  claimedBy         String?
  claimedAt         DateTime?
  /// Caller-supplied key that makes enqueue idempotent (e.g. "contract-signed:<bookingId>").
  dedupeKey         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status])
  @@index([claimedBy])
  @@index([bookingId])
}

/// Raw webhook envelope — the idempotency gate for Meta redeliveries.
model WhatsAppWebhookEvent {
  id              String    @id @default(uuid())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id])
  /// Stable key derived from the Meta payload (wamid / status id + status value).
  externalEventId String    @unique
  /// message | status | template_status | unknown
  eventType       String
  payload         Json
  /// Pending | Processing | Processed | Failed | Ignored
  status          String    @default("Pending")
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  retryCount      Int       @default(0)
  claimedBy       String?
  claimedAt       DateTime?
  error           String?   @db.Text

  @@index([status, receivedAt])
  @@index([tenantId, eventType])
}

/// Local template registry. Meta owns approval — `metaStatus` is never assumed.
model WhatsAppTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  language     String   @default("he")
  /// MARKETING | UTILITY | AUTHENTICATION (Meta categories)
  category     String   @default("UTILITY")
  /// Draft | Pending | Approved | Rejected | Disabled — mirrored from Meta, never inferred.
  metaStatus   String   @default("Draft")
  metaTemplateId String?
  /// Ordered parameter descriptors used to build `components` at send time.
  parameters   Json?
  /// Body preview for the UI. NOT the source of truth — Meta stores the real body.
  bodyPreview  String?  @db.Text
  version      Int      @default(1)
  metadata     Json?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automationRules WhatsAppAutomationRule[]

  @@unique([tenantId, name, language])
  @@index([tenantId, metaStatus])
}

/// Declarative automation: trigger + conditions + action. No hard-coded workers.
model WhatsAppAutomationRule {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  name                 String
  /// ContractSigned | PaymentOverdue | EventApproaching | IncomingMessage | ProductionFormReady
  triggerType          String
  /// Handler-specific JSON (e.g. { "daysBefore": 30, "requirements": ["tablecloth"] }).
  triggerConfiguration Json?
  templateId           String?
  template             WhatsAppTemplate? @relation(fields: [templateId], references: [id])
  /// SendWhatsAppToCustomer | SendWhatsAppToManager | NotifyManagerInApp
  actionType           String   @default("SendWhatsAppToCustomer")
  actionConfiguration  Json?
  isEnabled            Boolean  @default(false)
  lastRunAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, triggerType, isEnabled])
}
