# Maple Garden Events — Client (copy to .env)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Brand / tenant id used by getBrandConfig (maple → גן אירועים מייפל)
VITE_TENANT_NAME=maple
# Leave empty in production when the server serves the built client (same-origin /api)
# Leave empty in dev — Vite proxies /api to http://127.0.0.1:5000
# Do NOT set http://localhost:5000 here; that bypasses the proxy and breaks login if the server is down
VITE_API_URL=

# --- Sentry (optional — baked in at Vite build time) ---
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
