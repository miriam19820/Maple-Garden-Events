# Stage 1: build React app
FROM node:20-bookworm-slim AS build

WORKDIR /app

ENV npm_config_strict_ssl=false

# npm workspaces: install from the single root lockfile (per-package lock files were dropped)
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY client/package.json ./client/
COPY server/package.json ./server/

RUN npm ci --workspace=client --workspace=@maple/shared --include-workspace-root=false

# Build the shared workspace package first — client imports it as @maple/shared
COPY shared ./shared
RUN cd shared && npm run build

COPY client/ ./client/
WORKDIR /app/client

ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_API_URL=/api
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_TRACES_SAMPLE_RATE
ARG VITE_TENANT_NAME
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_TRACES_SAMPLE_RATE=$VITE_SENTRY_TRACES_SAMPLE_RATE
ENV VITE_TENANT_NAME=$VITE_TENANT_NAME

RUN npx vite build

# Stage 2: nginx serves static files + proxies API
FROM nginx:stable-alpine

RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

COPY --from=build /app/client/dist /usr/share/nginx/html
COPY routing/http.conf.template /etc/nginx/templates/http.conf.template
COPY routing/ssl.conf.template  /etc/nginx/templates/ssl.conf.template
COPY routing/entrypoint.sh      /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 443

CMD ["/entrypoint.sh"]
